{
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "target": "ES2022",
    "useDefineForClassFields": false,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "declaration": false,
    "sourceMap": true,
    "emitDecoratorMetadata": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "module": "ES2022",
    "types": [],
    "strict": true
  }
}